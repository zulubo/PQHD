    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DetailNormalUnpack",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Normal.xy = NormalXY * 2.0 - 1.0;\nNormal.xy *= Strength;\r\nNormal.z = max(1.0e-16, sqrt(1.0 - saturate(dot(Normal.xy, Normal.xy))));"
}

